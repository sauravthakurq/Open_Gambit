rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isGamePlayer(gameData) {
      return request.auth.uid == gameData.whiteUid ||
        request.auth.uid == gameData.blackUid;
    }

    function isGameCompleted(gameData) {
      return gameData.status == 'completed' || gameData.status == 'aborted';
    }

    function isCorrectTurn(gameData) {
      return (request.auth.uid == gameData.whiteUid && gameData.turn == 'w') ||
        (request.auth.uid == gameData.blackUid && gameData.turn == 'b');
    }

    function keepsPlayersImmutable() {
      return request.resource.data.whiteUid == resource.data.whiteUid &&
        request.resource.data.blackUid == resource.data.blackUid;
    }

    function changesOnlyGameFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'fen', 'pgn', 'turn', 'moveCount', 'lastMoveAt',
        'status', 'result', 'endReason', 'drawOfferBy'
      ]);
    }

    function isValidMoveUpdate() {
      return isCorrectTurn(resource.data) &&
        request.resource.data.moveCount == resource.data.moveCount + 1 &&
        request.resource.data.turn != resource.data.turn &&
        request.resource.data.fen is string &&
        request.resource.data.pgn is string;
    }

    function isDrawOfferUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['drawOfferBy']) &&
        (request.resource.data.drawOfferBy == request.auth.uid ||
          request.resource.data.drawOfferBy == null);
    }

    function isAcceptedDrawUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['drawOfferBy', 'status', 'result', 'endReason']) &&
        resource.data.drawOfferBy != null &&
        resource.data.drawOfferBy != request.auth.uid &&
        request.resource.data.drawOfferBy == null &&
        request.resource.data.status == 'completed' &&
        request.resource.data.result == 'draw' &&
        request.resource.data.endReason == 'agreement';
    }

    function isResignationUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'result', 'endReason']) &&
        request.resource.data.status == 'completed' &&
        request.resource.data.endReason == 'resignation' &&
        ((request.auth.uid == resource.data.whiteUid &&
          request.resource.data.result == 'black') ||
         (request.auth.uid == resource.data.blackUid &&
          request.resource.data.result == 'white'));
    }

    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isOwner(uid);
      allow delete: if false;
    }

    match /games/{gameId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
        (request.resource.data.whiteUid == request.auth.uid ||
          request.resource.data.blackUid == request.auth.uid);

      allow update: if isAuthenticated() &&
        isGamePlayer(resource.data) &&
        !isGameCompleted(resource.data) &&
        keepsPlayersImmutable() &&
        changesOnlyGameFields() &&
        (isValidMoveUpdate() || isDrawOfferUpdate() ||
          isAcceptedDrawUpdate() || isResignationUpdate());

      allow delete: if false;

      match /moves/{moveId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          isGamePlayer(get(/databases/$(database)/documents/games/$(gameId)).data) &&
          isCorrectTurn(get(/databases/$(database)/documents/games/$(gameId)).data) &&
          request.resource.data.playerUid == request.auth.uid;
        allow update, delete: if false;
      }

      match /chat/{msgId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          isGamePlayer(get(/databases/$(database)/documents/games/$(gameId)).data) &&
          request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.hostUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.hostUid == request.auth.uid ||
        (resource.data.guestUid == null &&
          request.resource.data.guestUid == request.auth.uid)
      );
      allow delete: if isAuthenticated() &&
        resource.data.hostUid == request.auth.uid;
    }

    match /matchmaking/{entryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.uid == request.auth.uid;
    }

    match /notifications/{uid}/{notifId} {
      allow read: if isAuthenticated() && isOwner(uid);
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && isOwner(uid);
    }
  }
}
